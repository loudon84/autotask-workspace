# 复制为 .env 后填写。只有 .env 会被程序读取。.env.example 仅作 key 清单，值保持空。
# .env.development / .env.production 只是你自己的备份，启动和发版都不会读。

VITE_AUTOTASK_API_MODE=
VITE_AUTOTASK_AUTH_BACKEND_URL=
VITE_AUTOTASK_TASK_BACKEND_URL=
VITE_AUTOTASK_RPA_ENGINE_URL=
SMC_RELEASE_HOST=
SMC_RELEASE_USER=
SMC_RELEASE_ROOT=
AUTOTASK_UPDATE_URL=
