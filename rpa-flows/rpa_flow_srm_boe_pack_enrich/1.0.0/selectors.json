  "item_input": "input[placeholder*='物料编码']:visible",
  "search_button": "button:has-text('搜索'):visible, button:has-text('查询'):visible",
  "popup_save": ".el-dialog button:has-text('保存'):visible",
  "popup_row": ".el-dialog .el-table__body-wrapper tbody tr:visible",
  "popup_checkbox": ".el-dialog .el-table__body-wrapper tbody tr .el-checkbox:visible",
  "draft_no": ".el-form-item:has-text('流水号') input:visible, text=/发票箱单流水号/",
