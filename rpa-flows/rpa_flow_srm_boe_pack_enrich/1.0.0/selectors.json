  "create_button": "button:has-text('新建'):visible",
  "save_button": "button:has-text('保存'):visible",
  "submit_button": "button:has-text('提交'):visible",
  "add_line_button": "button:has-text('新增'):visible",
  "invoice_no": "input[placeholder*='供应商发票']:visible, .el-form-item:has-text('供应商发票号') input:visible",
