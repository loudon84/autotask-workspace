  "date_picker_confirm": ".el-date-range-picker:visible .el-picker-panel__footer button:has-text('确定')",
  "date_picker_prev_year": ".el-date-range-picker:visible .el-icon-d-arrow-left",
  "date_picker_prev_month": ".el-date-range-picker:visible .el-icon-arrow-left",
  "date_picker_next_month": ".el-date-range-picker:visible .el-icon-arrow-right",
  "date_picker_next_year": ".el-date-range-picker:visible .el-icon-d-arrow-right",
  "search_button": "button:has-text('查询'):visible",
  "export_button": "button:has-text('导出'):visible",
  "export_confirm": ".el-dialog:visible button:has-text('确定'), .el-message-box:visible button:has-text('确定')",
  "empty_text": ".el-table__empty-text:visible, .el-empty:visible, .el-table__empty-block:visible",
  "loading_mask": ".el-loading-mask:visible"
