{
  "username": "input[placeholder='账号或手机号码']:visible",
  "password": "input[type='password']:visible",
  "captcha": "input[placeholder='验证码']:visible",
  "captcha_image": ".el-form-item:has(input[placeholder='验证码']) img:visible",
  "agreement": ".userAgree .el-checkbox:visible .el-checkbox__inner, .userAgree .el-checkbox:visible",
  "login_button": "button:has-text('登录'):visible",
  "login_error": ".el-message--error",
  "login_success": ".el-menu-item:has-text('订单'):visible",
  "login_ready": "input[placeholder='账号或手机号码']:visible, input[type='password']:visible",
  "order_page": ".el-table",
  "po_number": ".el-form-item:has-text('订单编号') input:visible",
  "search_button": "button:has-text('查询'):visible",
  "order_row": ".el-table__body-wrapper tbody tr:has-text('{po_no}'):visible",
  "order_detail": ".el-table__body-wrapper tbody tr:has-text('{po_no}') >> text=详情",
  "detail_page": "#app",
  "detail_po_number": "text={po_no}",
  "lines_table": ".el-table",
  "detail_rows": ".el-table__body-wrapper tbody tr",
  "download_order": "button:has-text('下载订单'):visible, a:has-text('下载订单'):visible",
  "download_confirm": ".el-dialog:visible button:has-text('确定'), .el-message-box:visible button:has-text('确定')",
  "download_dialog": ".el-dialog",
  "loading_mask": ".el-loading-mask"
}
