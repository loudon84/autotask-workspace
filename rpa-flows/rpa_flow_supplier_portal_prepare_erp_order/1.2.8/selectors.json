{
  "username": "input[placeholder='账号或手机号码']:visible, [data-rpa='login-username']",
  "password": "input[type='password']:visible, [data-rpa='login-password']",
  "captcha": "input[placeholder='验证码']:visible, [data-rpa='login-captcha']",
  "captcha_image": "img[data-probe-captcha='1'], img[data-rpa='login-captcha-image']",
  "agreement": "label:has-text('用户注册协议') input[type='checkbox'], [data-rpa='login-agreement'] input[type='checkbox']",
  "login_button": "button:has-text('登录'):visible, button[data-rpa='login-submit']",
  "login_error": ".el-message--error",
  "login_success": "[data-rpa='portal-env-tag']",
  "login_ready": "input[placeholder='账号或手机号码']:visible, [data-rpa='portal-env-tag']:visible, img[data-rpa='login-captcha-image']:visible",
  "order_page": ".el-table:visible, [data-rpa='order-list-page']",
  "po_number": ".el-form-item:has-text('订单编号') input:visible, [data-rpa='order-no-input']",
  "search_button": "button:has-text('查询'):visible, [data-rpa='order-search-btn']",
  "order_row": "[data-rpa='order-row-{po_no}']:visible",
  "order_detail": "[data-rpa='order-detail-{po_no}']:visible",
  "detail_page": "[data-rpa='order-detail-page'], [data-rpa='pend-order-detail-page']",
  "detail_po_number": "[data-rpa='order-detail-no-{po_no}']:visible, [data-rpa='pend-order-detail-no-{po_no}']:visible",
  "lines_table": "[data-rpa='order-detail-lines-table'], [data-rpa='pend-order-detail-lines-table'], .el-table:visible",
  "detail_rows": "[data-rpa='order-detail-page'] .el-table__body-wrapper tbody tr, [data-rpa='pend-order-detail-lines-table'] .el-table__body-wrapper tbody tr, .el-table__body-wrapper tbody tr",
  "download_order": "button:has-text('下载订单'):visible, a:has-text('下载订单'):visible, [data-rpa='order-detail-download-btn']:visible, [data-rpa='pend-order-detail-download-btn']:visible",
  "download_confirm": "button:has-text('确定'):visible, [data-rpa='download-confirm-btn']",
  "download_dialog": ".el-dialog:visible",
  "loading_mask": ".el-loading-mask:visible"
}
