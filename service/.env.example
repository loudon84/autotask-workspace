APP_NAME=nodeskclaw-task
APP_ENV=development
HOST=0.0.0.0
PORT=4520
PUBLIC_BASE_URL=http://127.0.0.1:4520

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nodeskclaw_task

JWT_SECRET=replace-with-nodeskclaw-backend-secret
JWT_ALGORITHM=HS256

NODESKCLAW_BACKEND_URL=http://127.0.0.1:4510
NODESKCLAW_AUTH_ME_PATH=/api/v1/auth/me
USER_CACHE_TTL_MINUTES=10

ARTIFACT_STORAGE=local
ARTIFACT_LOCAL_DIR=./storage/artifacts
ARTIFACT_UPLOAD_BASE_URL=
ARTIFACT_DOWNLOAD_BASE_URL=
S3_ENDPOINT=https://s3.example.com
S3_REGION=
S3_BUCKET=nodeskclaw-task-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=autotask
S3_PRESIGN_EXPIRES_SECONDS=3600

RPA_ENGINE_BASE_URL=http://rpa-engine.example.com:4610
RPA_ENGINE_VALIDATE_BINDING=true
SEED_DATA_ENABLED=false
SKIP_AUTO_MIGRATE=1

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000

WORKER_LEASE_TTL_SECONDS=60
WORKER_HEARTBEAT_TIMEOUT_SECONDS=60

# === 后台作业开关（上线必查）===
# SUCCESSOR_JOB：子任务跑完自动触发下一阶段（建单→交期→签章→归档）。流程实例自动推进靠它，上线必须 true。
# 扫单 / 回签 / 京东方匹配不要再写 SCAN_JOB_* / SIGN_POLL_JOB_* / BOE_PACK_MATCH_JOB_*。
SUCCESSOR_JOB_ENABLED=false
SUCCESSOR_JOB_POLL_INTERVAL_SECONDS=2
SUCCESSOR_JOB_BATCH_SIZE=10
SUCCESSOR_JOB_MAX_ATTEMPTS=10

# 环境级外部系统。测试/正式只改域名，不要写进 Binding JSON、不要写进登录页。
# SMC_API_BASE_URL：公司内部 SQL→JSON 接口平台。具体路径写死在代码里，不要为每条接口加键。
# SDMS_BASE_URL：SDMS 网页主机（Client 打开销售订单/对账单/交货计划查看链接）。
# 密钥不要提交到 Git。
SMC_API_BASE_URL=
SDMS_BASE_URL=
ERP_BASE_URL=
OA_BASE_URL=
ERP_CLIENT_ID=
ERP_CLIENT_SECRET=
SDMS_ATTACHMENT_API_BASE_URL=

# 阿里企业邮箱 IMAP（只读探测 / 以后 Task 邮件读取）。授权码不是网页登录密码。不要提交真实值。
ALI_MAIL_HOST=imap.qiye.aliyun.com
ALI_MAIL_PORT=993
ALI_MAIL_USER=
ALI_MAIL_AUTH=
ALI_MAIL_FOLDER=BOE-SRM一站式平台-验证码
ALI_MAIL_READONLY=true
